{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='liroxnotes-app' || @.name.value=='liroxnotes-backend' || @.name.value=='liroxnotes-shared')].version"
        }
      ],
      "release-as": "0.1.0"
    }
  }
}
