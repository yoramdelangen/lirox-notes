#!/bin/sh
set -eu

bun run build:css
(cd packages/editor && bun run build)

gateway_port="${LIROX_GATEWAY_PORT:-3000}"
LIROX_DEV_CORS=1 cargo run -p liroxnotes-gateway -- --port "$gateway_port" &
gateway_pid=$!

cleanup() {
  kill "$gateway_pid" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

dx serve --platform web --package liroxnotes-app "$@"
